# IMAP Settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
IMAP_PASS=tu_app_password
# Carpeta o etiqueta a leer (en Gmail, el nombre de la etiqueta). Por defecto: inbox.
IMAP_MAILBOX=inbox

# Alegra API Settings
ALEGRA_EMAIL=tu_correo_alegra
ALEGRA_TOKEN=tu_token_alegra
ALEGRA_CUENTA_DEFAULT_GASTOS=5001

# PostgreSQL Settings
DATABASE_URL=postgresql://syncbank:syncbank@postgres:5432/syncbank
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# App Settings
APP_ENV=development
ADMIN_API_KEY=cambia_esta_clave
ADMIN_USERNAME=admin

# Observability
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sync-bank-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Login con Google (opcional). Redirect URI en Google Cloud: <tu-dominio>/login/google/callback
# Por defecto solo entra IMAP_USER; agrega mas correos separados por coma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_EMAILS=

# Obligatorias en produccion (APP_ENV=production). SESSION_SECRET firma la cookie y debe ser
# distinta de ADMIN_API_KEY. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# NIT de la empresa: se bloquea causar facturas emitidas a otro NIT (sin digito de verificacion, ej. 900741732)
COMPANY_NIT=

# Solo se leen y muestran facturas emitidas desde esta fecha (AAAA-MM-DD)
MIN_ISSUE_DATE=2026-09-01
# Desde esta fecha se aprenden las reglas de cuenta y centro de costo (AAAA-MM-DD)
LEARNING_START_DATE=2026-01-01
